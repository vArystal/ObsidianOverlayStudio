{
  "name": "obsidian-overlay-studio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "dev:server": "node --watch server/index.mjs",
    "start:server": "node server/index.mjs",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run && node --test server/*.test.mjs && node --test worker/index.test.mjs",
    "test:frontend": "vitest run",
    "test:server": "node --test server/*.test.mjs",
    "test:watch": "vitest",
    "check": "npm test && npm run build",
    "test:worker": "node --test worker/index.test.mjs",
    "preview:dist": "vite preview --host 0.0.0.0",
    "build:pages": "node scripts/build-pages.mjs",
    "deploy:pages": "node scripts/build-pages.mjs && wrangler pages deploy worker/pages --project-name=obsidian-overlay-api --branch=main --commit-dirty=true"
  },
  "dependencies": {
    "lucide-react": "^0.468.0",
    "lz-string": "^1.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/lz-string": "^1.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "typescript": "~5.6.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  }
}
