# Integration backend (server/index.mjs)
HOST=0.0.0.0
PORT=8787
NODE_ENV=development

# Comma-separated exact frontend origins allowed by CORS and OAuth return validation.
# Production example: https://varystal.github.io
APP_ORIGIN=http://localhost:5173

# Externally reachable HTTPS origin of this backend. No trailing slash.
# Production example: https://overlay-api.example.com
PUBLIC_API_URL=http://localhost:8787

# Register these in the Kick developer application. Keep both values server-side.
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Must exactly match the redirect URI registered with Kick.
# Production must be publicly reachable HTTPS.
KICK_REDIRECT_URI=http://localhost:8787/api/auth/kick/callback

# Minimum 32 random characters. Generate, for example:
# node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Rotating this key makes existing encrypted token records unreadable.
TOKEN_ENCRYPTION_KEY=

# Persistent private storage for encrypted tokens and integration metadata.
# Keep outside any publicly served directory and use a persistent volume in production.
DATA_FILE=./data/integrations.json

# Kick active-livestream viewer polling; values below 15000 are clamped.
VIEWER_POLL_INTERVAL_MS=30000

# Frontend build variable. Set to the same public backend origin before `npm run build`.
# Leave empty only when the frontend is reverse-proxied to /api on the same origin.
VITE_INTEGRATION_API_URL=

# Development-only Vite server proxy target. Browser calls remain same-origin /api.
INTEGRATION_PROXY_TARGET=http://localhost:8787
